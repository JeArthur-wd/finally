# OpenRouter API key for the AI chat assistant (optional: the app starts without it,
# only the chat is disabled). Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Massive (Polygon.io) API key for real market data (optional).
# Leave empty to use the built-in market simulator (recommended).
MASSIVE_API_KEY=

# Set to "true" for deterministic mock LLM responses (E2E tests / no API key).
LLM_MOCK=false
